OPENROUTER_API_KEY=
AI_MODEL_CODE=anthropic/claude-haiku-5.5
AI_MODEL_CV=anthropic/claude-haiku-5.5
AI_DAILY_BUDGET_USD=5
# Plusieurs jetons GitHub en rotation, séparés par des virgules (5 000 appels par
# heure chacun). Absent : GITHUB_TOKEN seul.
GITHUB_TOKENS=
GITHUB_TOKEN=
# Fiches traitées en même temps ; les suivantes attendent en file (position affichée).
MAX_CONCURRENT_CARDS=4
BASE_URL=http://localhost:5180
DB_PATH=./var/cards.db
LEADS_ENDPOINT=
PORT=8787
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# « C'est moi » : revendiquer sa fiche par GitHub OAuth (SPEC §18.1). Les trois
# ou rien : sans elles, le bouton n'apparaît pas. Application OAuth GitHub
# (github.com/settings/developers), adresse de retour à y déclarer :
#   https://skills.azerit.tech/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signe le cookie de session (HMAC-SHA256) : openssl rand -hex 32. Le changer
# déconnecte tout le monde, sans perdre les revendications.
SESSION_SECRET=
# Sel du hachage des IP (limite par IP) : une valeur aléatoire en production, openssl rand -hex 32
IP_SALT=
