OPENROUTER_API_KEY=
AI_MODEL_CODE=z-ai/glm-5.3-flash
AI_MODEL_CV=z-ai/glm-5.3-flash
AI_DAILY_BUDGET_USD=5
# Solde OpenRouter (lu toutes les 5 minutes) sous lequel le commissariat ferme.
AI_MIN_CREDIT_USD=0.05
# Plusieurs jetons GitHub en rotation, séparés par des virgules (5 000 appels par
# heure chacun). Absent : GITHUB_TOKEN seul.
GITHUB_TOKENS=
GITHUB_TOKEN=
# Fiches traitées en même temps ; les suivantes attendent en file (position affichée).
MAX_CONCURRENT_CARDS=4
# Délai de traitement d'une fiche, en millisecondes (défaut 60000), compté à la
# sortie de la file (3 min au plus en file). Une lecture LinkedIn lente le
# repousse de 60 s au plus ; le front patiente d'autant, il lit le délai du serveur.
CARD_TIMEOUT_MS=60000
BASE_URL=http://localhost:5180
DB_PATH=./var/cards.db
LEADS_ENDPOINT=
PORT=8787
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# « C'est moi » : revendiquer sa fiche par GitHub OAuth (SPEC §18.1). Les trois
# ou rien : sans elles, le bouton n'apparaît pas. Application OAuth GitHub
# (github.com/settings/developers), adresse de retour à y déclarer :
#   https://skills.azerit.tech/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signe le cookie de session (HMAC-SHA256) : openssl rand -hex 32. Le changer
# déconnecte tout le monde, sans perdre les revendications.
SESSION_SECRET=
# Sel du hachage des IP (limite par IP) : une valeur aléatoire en production, openssl rand -hex 32
IP_SALT=
# LinkedIn contre GitHub, et l'entrée LinkedIn (SPEC §18.24). Fournisseur des
# profils publics : apify (défaut) ou crustdata. Sans son jeton : fonctionnalité absente.
LINKEDIN_PROVIDER=apify
# Apify : jeton d'API, acteur « user~actor » (défaut harvestapi~linkedin-profile-scraper,
# sans cookies ni email), et son entrée JSON, {url} = l'adresse du profil.
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=
APIFY_LINKEDIN_INPUT=
# Profils lus par jour, tous fournisseurs (défaut 300) ; au-delà, la fiche GitHub sort seule.
LINKEDIN_DAILY_PROFILES=300
# Crustdata (API 2025-11-01) : avec LINKEDIN_PROVIDER=crustdata, ou pour la seule
# recherche payante du LinkedIn d'un GitHub qui n'en affiche pas (LINKEDIN_AUTOFIND=crustdata).
CRUSTDATA_API_KEY=
LINKEDIN_AUTOFIND=
# Employeurs à forte barre d'embauche (SPEC §18.37, critère Parcours) : chemin
# d'un fichier JSON du serveur, hors du dépôt public, de la forme de
# data/employers.example.json (en conteneur, dans le volume /data, à côté de la
# base). Vide : liste vide, rien ne plante, les niveaux 8 et 10 du parcours ne
# s'ouvrent que par les startups et scale-ups.
HIGH_BAR_EMPLOYERS_FILE=
# La vitrine de l'accueil (SPEC §6.1, §18.35) : le pseudo de la fiche d'exemple
# (défaut jmougeot), sa photo et son LinkedIn. Son GitHub n'affiche pas ce LinkedIn :
# le serveur se porte garant du lien, et leur comparaison compte comme prouvée.
# Photo et LinkedIn par défaut (ceux de Jacques) seulement avec le pseudo par défaut.
# En commentaire : une variable laissée vide remplace la valeur par défaut.
# SHOWCASE_LOGIN=jmougeot
# SHOWCASE_PHOTO=/jmougeot-linkedin.jpg
# SHOWCASE_LINKEDIN=https://www.linkedin.com/in/jacquesmougeot
