{
  "name": "testyourskills",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch --env-file-if-exists=.env server/src/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "weekly": "tsx --env-file-if-exists=.env scripts/weekly.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "percentiles": "tsx --env-file-if-exists=.env scripts/percentiles.ts",
    "bands:review": "tsx --env-file-if-exists=.env scripts/bands-review.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/three": "^0.186.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "gltfpack": "^1.3.0",
    "typescript": "~5.7",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
