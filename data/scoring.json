          { "school": "42", "tier": "B", "pattern": "^(l )?(ecole )?42\\b|\\becole 42\\b|\\b42 (paris|school|network)\\b" },
          { "school": "Dauphine", "tier": "B", "pattern": "\\bdauphine\\b" },
          { "school": "Université PSL", "tier": "A", "pattern": "\\bpsl\\b|paris sciences (et|and) lettres" },
          { "school": "Université Paris-Saclay", "tier": "B", "pattern": "\\bparis saclay\\b|universite paris sud|\\bparis (11|xi)\\b" },
