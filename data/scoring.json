    "aiTopics": ["ai", "ml", "machine-learning", "deep-learning", "llm", "nlp", "artificial-intelligence", "neural-network", "gpt", "rag"]
  },

  "position": {
    "_doc": "Score par poste = somme des signaux. Langages : part des octets × poids. Dépendances : depWeight par dépendance distincte reconnue, au plus maxDepsPerRepo par repo et par poste. Marqueurs d'arbre et topics : poids fixe par repo. FS si FE et BE sont tous deux au-dessus de fsRatio du meilleur.",
    "default": "FS",
    "fsRatio": 0.5,
    "languages": {
      "TypeScript": { "FE": 0.5, "BE": 0.5 },
      "JavaScript": { "FE": 0.6, "BE": 0.4 },
      "HTML": { "FE": 1 },
      "CSS": { "FE": 1 },
      "SCSS": { "FE": 1 },
      "Vue": { "FE": 1 },
      "Svelte": { "FE": 1 },
      "Astro": { "FE": 1 },
      "Python": { "BE": 0.5, "DATA": 0.3, "ML": 0.2 },
      "Jupyter Notebook": { "DATA": 0.6, "ML": 0.4 },
      "R": { "DATA": 1 },
      "Julia": { "DATA": 0.5, "ML": 0.5 },
      "Go": { "BE": 0.8, "OPS": 0.2 },
      "Rust": { "BE": 0.5, "EMB": 0.5 },
      "C": { "EMB": 1 },
      "C++": { "EMB": 0.6, "BE": 0.4 },
      "Assembly": { "EMB": 1 },
      "Zig": { "EMB": 0.6, "BE": 0.4 },
      "Java": { "BE": 0.8, "MOB": 0.2 },
      "Kotlin": { "MOB": 0.6, "BE": 0.4 },
      "Swift": { "MOB": 1 },
      "Objective-C": { "MOB": 1 },
      "Dart": { "MOB": 1 },
      "C#": { "BE": 1 },
      "Ruby": { "BE": 1 },
      "PHP": { "BE": 1 },
      "Elixir": { "BE": 1 },
      "Scala": { "BE": 0.6, "DATA": 0.4 },
      "HCL": { "OPS": 1 },
      "Shell": { "OPS": 1 },
      "Dockerfile": { "OPS": 1 },
      "Nix": { "OPS": 1 },
      "Solidity": { "BE": 1 }
    },
    "languageWeight": 10,
    "depWeight": 3,
    "maxDepsPerRepo": 3,
    "deps": {
      "FE": ["react", "react-dom", "vue", "@angular/core", "svelte", "solid-js", "preact", "lit", "@builder.io/qwik", "ember-source", "backbone", "jquery", "tailwindcss", "vite", "webpack"],
