          { "school": "Tsinghua", "tier": "S", "pattern": "\\btsinghua\\b" },
          { "school": "UC Berkeley", "tier": "A", "pattern": "\\bberkeley\\b" },
          { "school": "Carnegie Mellon", "tier": "A", "pattern": "carnegie mellon|\\bcmu\\b" },
