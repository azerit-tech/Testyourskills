          { "school": "University of Waterloo", "tier": "A", "pattern": "university of waterloo|\\buwaterloo\\b|^waterloo$" },
          { "school": "Cornell", "tier": "A", "pattern": "\\bcornell\\b" },
          { "school": "UIUC", "tier": "A", "pattern": "\\buiuc\\b|university of illinois (at )?urbana" },
