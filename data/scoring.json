{
  "version": "0.4.0",
  "_doc": "Barème versionné (SPEC §4.4, §4.5). Échelles : points [x, note], interpolation linéaire, arrondi, bornes 1..99. Changer un point = changer la version. Depuis 0.4.0, la note d'une fiche est celle de la grille de recrutement (data/grid.json) ; ces échelles font les six barres, sauf XP qui lit le critère Expérience × 10.",
  "bounds": { "min": 1, "max": 99 },
  "weights": { "TEC": 0.3, "SHIP": 0.2, "ARCH": 0.2, "DOC": 0.15, "XP": 0.15 },
  "reliability": { "perAxis": 19, "max": 95 },
  "special": {
    "wonderkid": { "xpBelow": 45, "tecAtLeast": 70 },
    "flashback": { "oldShareAtLeast": 0.6, "olderThanYears": 5, "minContributions": 50, "maxWeeksActive": 26 }
  },

  "github": {
    "activeRepos": 5,
    "readRepos": 3,
    "activity": { "recencyPoints": 6, "recencyHalfLifeDays": 120 },
    "mainLanguage": {
      "_doc": "Langage principal = somme, sur les repos où il est principal, de repoBase + activityLogWeight × ln(1 + activité). Balisage ignoré s'il y a autre chose.",
      "repoBase": 1,
      "activityLogWeight": 1,
      "ignore": ["HTML", "CSS", "SCSS", "Less", "Makefile", "Dockerfile", "Batchfile", "TeX", "Roff"]
    },
    "lazyCommit": {
      "minLength": 8,
      "pattern": "^(fix|wip|update|test|final|stuff|asdf|changes|minor)[\\s\\d.!]*$"
    },
    "tutorial": {
      "pattern": "todo|tutorial|hello-world|clone|portfolio-v\\d|test-?\\d*|learn",
      "maxCommits": 5
    },
    "nightHours": { "from": 1, "to": 5 },
    "fridayEveningFromHour": 18,
    "aliveWithinDays": 365,

    "SHIP": {
      "scale": [[0, 20], [13, 50], [26, 70], [40, 85], [52, 99]],
      "releaseBonus": 5,
      "releasesAtLeast": 3,
      "releasesWithinDays": 365
    },
    "ARCH": {
      "weights": { "tests": 50, "ci": 30, "tooling": 20 },
      "scale": [[0, 25], [100, 99]],
      "sufficientActiveRepos": 2,
      "activeWithinDays": 730
    },
    "DOC": {
      "readmeWordsAtLeast": 300,
      "weights": { "readme": 60, "commits": 40 },
      "scale": [[0, 25], [100, 99]],
      "lazyShareWhenUnknown": 0.5,
      "readableCommitsPerRepo": 5,
      "sufficientRepos": 2
    },
    "XP": {
      "scale": [[0, 25], [1, 40], [3, 60], [5, 75], [8, 88], [12, 99]],
      "breadthMinBytes": 10240,
      "breadthBonus": [[4, 4], [6, 8]],
      "sufficientRepoCommits": 10
    },
    "TEC": {
      "levelScale": [[1, 35], [2, 50], [3, 65], [4, 80], [5, 95]],
      "fallback": 50,
      "externalPrBonus": 4,
      "externalPrsAtLeast": 5,
      "sufficientRepoCommits": 20
    },
    "BUZZ": {
      "weights": { "tutorials": 50, "lazy": 50 },
      "scale": [[0, 10], [100, 99]]
    }
  },

  "cv": {
    "TEC": {
      "seniority": { "junior": 50, "mid": 65, "senior": 80, "lead": 88, "staff": 88 },
      "perDescribedTechno": 2,
      "school": {
        "_doc": "Rang d'école, pour le critère EDU de la grille (data/grid.json) : il n'entre plus dans TEC (0.4.0). Le nom rendu par l'IA est normalisé (minuscules, sans accents, toute ponctuation devient une espace) puis comparé aux motifs dans l'ordre : le premier qui correspond donne le rang, d'où les cas particuliers avant les familles. Hors liste, le rang de l'IA est plafonné à aiMaxTier. « none » de l'IA (pas d'études supérieures liées à la tech) reste « none ».",
        "aiMaxTier": "B",
        "list": [
          { "school": "Polytech", "tier": "C", "pattern": "\\bpolytech\\b|polytechnique universitaire" },
          { "school": "ECE", "tier": "C", "pattern": "^ece\\b|\\bece (paris|lyon)\\b|ecole centrale d electronique" },
          { "school": "Epitech", "tier": "C", "pattern": "\\bepitech\\b" },
          { "school": "EFREI", "tier": "C", "pattern": "\\befrei\\b" },
          { "school": "ESIEA", "tier": "C", "pattern": "\\besiea\\b" },
          { "school": "ESILV", "tier": "C", "pattern": "\\besilv\\b" },
          { "school": "ISEP", "tier": "C", "pattern": "\\bisep\\b" },
          { "school": "ESIEE Paris", "tier": "C", "pattern": "\\besiee\\b" },
          { "school": "Supinfo", "tier": "C", "pattern": "\\bsupinfo\\b" },

          { "school": "CentraleSupélec", "tier": "A", "pattern": "centrale ?supelec|\\bsupelec\\b|(ecole )?centrale (de )?paris\\b|ecole centrale des arts et manufactures" },
          { "school": "Centrale Lyon", "tier": "B", "pattern": "centrale (de )?lyon\\b" },
          { "school": "Centrale Nantes", "tier": "B", "pattern": "centrale (de )?nantes\\b" },
          { "school": "Centrale Lille", "tier": "B", "pattern": "centrale (de )?lille\\b|\\biteem\\b" },
          { "school": "Centrale Méditerranée", "tier": "B", "pattern": "centrale (de )?(mediterranee|marseille)\\b|\\begim\\b" },
          { "school": "Centrale (autres)", "tier": "B", "pattern": "^centrale\\b|\\becole centrale\\b|\\bcentrale (casablanca|pekin|beijing|mahindra)\\b" },
          { "school": "Mines Paris", "tier": "A", "pattern": "\\bmines paris(tech)?\\b|ecole (nationale superieure )?des mines de paris|\\bmines psl\\b" },
          { "school": "IMT Atlantique", "tier": "B", "pattern": "\\bimt atlantique\\b" },
          { "school": "Mines (autres)", "tier": "B", "pattern": "\\bmines\\b" },
          { "school": "École des Ponts", "tier": "A", "pattern": "\\bponts\\b|\\benpc\\b" },
          { "school": "Télécom Paris", "tier": "A", "pattern": "\\btelecom paris(tech)?\\b|\\benst\\b(?! bretagne)" },
          { "school": "Télécom (autres)", "tier": "B", "pattern": "^telecom\\b|\\benst bretagne\\b|\\btelecom (sudparis|sud paris|nancy|saint etienne|st etienne|physique|bretagne|lille)\\b" },
          { "school": "ENSTA Bretagne", "tier": "B", "pattern": "\\bensta bretagne\\b" },
