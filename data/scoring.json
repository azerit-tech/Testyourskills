          { "school": "ISAE-SUPAERO", "tier": "A", "pattern": "\\bsup ?aero\\b|^isae$" },
          { "school": "ESPCI Paris", "tier": "A", "pattern": "\\bespci\\b" },
          { "school": "ENS Paris-Saclay", "tier": "A", "pattern": "\\bens (paris )?saclay\\b|\\bens cachan\\b|ecole normale superieure (de )?(paris saclay|cachan)\\b" },
          { "school": "ENS Lyon", "tier": "A", "pattern": "\\bens (de )?lyon\\b|ecole normale superieure (de )?lyon\\b" },
          { "school": "ENS Rennes", "tier": "B", "pattern": "\\bens (de )?rennes\\b|ecole normale superieure (de )?rennes\\b" },
